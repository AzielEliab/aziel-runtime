0 -11 Td
(        pair_id: "<AIH-WP-1.3 pair_id>",) Tj
0 -11 Td
(        hop: { n: 0, max: 8, seen: [] },) Tj
0 -11 Td
(        fh: "<sha256 fact>",) Tj
0 -11 Td
(        h: "<sha256 frame minus h>",) Tj
0 -11 Td
(        isolate: false,) Tj
