     llms: HOST + "/llms.txt",
     github: "https://github.com/AzielEliab/aziel-runtime",
     license: "Apache-2.0",
@@ -104,6 +113,9 @@ export function fallbackKind(destPath) {
   const path = String(destPath || "").split("?")[0].replace(/\/+$/, "") || "/";
   if (path === "/v1/runtime.json") return "runtime.json";
   if (path === "/v1/skill") return "skill";
+  if (path === "/v1/bundle") return "bundle-all";
+  const pullSkill = path.match(/^\/v1\/pull\/([^/]+)\/skill$/);
+  if (pullSkill) return { kind: "pull-skill", slug: decodeURIComponent(pullSkill[1]) };
   const pull = path.match(/^\/v1\/pull\/([^/]+)$/);
   if (pull) return { kind: "pull", slug: decodeURIComponent(pull[1]) };
   const bundle = path.match(/^\/v1\/bundle\/([^/]+)$/);
@@ -132,6 +144,8 @@ export function pullDescriptor(product, { kind = "pull" } = {}) {
     catalog_skill: product.catalog_skill || RUNTIME_ORIGIN + "/p/" + encodeURIComponent(slug) + "/skill",
     ops: Array.isArray(product.ops) ? product.ops : [],
     software_tarball: product.software_tarball || null,
+    skill_url: HOST + "/runtime/v1/pull/" + encodeURIComponent(slug) + "/skill",
+    invoke_prefix: RUNTIME_ORIGIN + "/p/" + encodeURIComponent(slug),
     pull: HOST + "/runtime/v1/pull/" + encodeURIComponent(slug),
     bundle: HOST + "/runtime/v1/bundle/" + encodeURIComponent(slug),
     runtime_root: HOST + "/runtime",
@@ -140,6 +154,46 @@ export function pullDescriptor(product, { kind = "pull" } = {}) {
   };
 }
 
+export function bundleListing(catalog) {
+  const products = catalog && Array.isArray(catalog.products) ? catalog.products : [];
+  return {
+    ok: true,
+    role: "runtime",
+    author: "Aziel Eliab",
+    identity: "Aziel Eliab",
+    product_count: products.length,
+    skill: HOST + "/runtime/v1/skill",
+    runtime: HOST + "/runtime/v1/runtime.json",
+    invoke: RUNTIME_ORIGIN + "/p/{slug}/{op}",
+    products: products.map((p) => ({
+      slug: p.slug,
+      name: p.name || p.slug,
+      version: p.version || null,
+      skill_url: HOST + "/runtime/v1/pull/" + encodeURIComponent(p.slug) + "/skill",
+      invoke_prefix: RUNTIME_ORIGIN + "/p/" + encodeURIComponent(p.slug),
+    })),
+    limitation: RUNTIME_LIMITATION,
+  };
+}
+
+export function fallbackSkillMd(product) {
+  const slug = product && product.slug ? String(product.slug) : "";
+  const name = (product && product.name) || slug;
+  return `# ${name}
+
+${(product && (product.one_line || product.banner)) || ""}
+
+Author: **Aziel Eliab**.
+
+Pull: ${HOST}/runtime/v1/pull/${encodeURIComponent(slug)}
+Skill: ${HOST}/runtime/v1/pull/${encodeURIComponent(slug)}/skill
+Invoke: ${RUNTIME_ORIGIN}/p/${encodeURIComponent(slug)}/{op}
+Download: ${(product && product.download) || ""}
+
+Always send \`User-Agent: Mozilla/5.0\`.
+`;
+}
+
 export function findProduct(catalog, slug) {
   const want = String(slug || "").toLowerCase();
   const products = catalog && Array.isArray(catalog.products) ? catalog.products : [];
@@ -207,6 +261,19 @@ async function fallbackResponse(request, kind) {
       headers: { "Content-Type": "text/markdown; charset=utf-8", ...corsHeaders(), "X-Aziel-Runtime-Via": "library-fallback" },
     }));
   }
+  if (kind === "bundle-all") {
+    const catalog = await loadCatalog();
+    return respondMaybeHead(request, json(bundleListing(catalog)));
+  }
+  if (kind && kind.kind === "pull-skill") {
+    const catalog = await loadCatalog();
+    const product = findProduct(catalog, kind.slug);
+    if (!product) return json({ error: "not found", slug: kind.slug, hint: "GET /runtime/v1/catalog.json", limitation: RUNTIME_LIMITATION }, 404);
+    return respondMaybeHead(request, new Response(fallbackSkillMd(product), {
+      status: 200,
+      headers: { "Content-Type": "text/markdown; charset=utf-8", ...corsHeaders(), "X-Aziel-Runtime-Via": "library-fallback" },
+    }));
+  }
   if (kind && (kind.kind === "pull" || kind.kind === "bundle")) {
     const catalog = await loadCatalog();
     const product = findProduct(catalog, kind.slug);
